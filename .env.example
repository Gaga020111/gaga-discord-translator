# Discord Developer Portal 的 Bot Token。請只填在雲端平台的秘密變數，不要傳給任何人。
DISCORD_TOKEN=

# Groq Console 的免費 API Key。
GROQ_API_KEY=

# 選填：測試時填伺服器 ID，斜線指令通常會立刻出現。
TEST_GUILD_ID=

# 建議先保留預設值。
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
GROQ_TRANSLATION_MODEL=openai/gpt-oss-20b
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
MAX_CONCURRENT_TRANSLATIONS=2

# 停頓多久後送出一段字幕，以及單段語音上限。
SILENCE_MS=900
MAX_UTTERANCE_MS=15000
MIN_UTTERANCE_MS=700
